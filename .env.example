# --- AI providers (only one is required; the others are optional fallbacks) ---
# The script tries these in PROVIDER_PRIORITY order and moves to the next one
# whenever the current provider fails (rate limited, quota exhausted, outage).
# Leave a key blank to skip that provider entirely.
PROVIDER_PRIORITY=anthropic,openai,google

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
# Model names above are examples -- check each provider's current docs/console
# for what's live on your account, since these change over time.

# --- Database ---
# Leave DATABASE_URL blank to use a local SQLite file (DB_PATH below).
# Set DATABASE_URL to a Supabase/Postgres connection string to use that instead
# (required for the GitHub Actions free-hosting path -- see README).
DATABASE_URL=
DB_PATH=./digest.db

# --- Email delivery (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
# Comma-separate for multiple recipients: EMAIL_TO=you@gmail.com,teammate@company.com

# --- Digest behavior ---
MAX_ARTICLES_PER_RUN=15
LOOKBACK_HOURS=26
CONTINUATION_LOOKBACK_DAYS=21
CONTINUATION_SIMILARITY_THRESHOLD=0.34
